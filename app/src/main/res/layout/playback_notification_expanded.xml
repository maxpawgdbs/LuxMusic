<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_background"
    android:orientation="vertical"
    android:padding="14dp"
    tools:ignore="UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_artwork"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/notification_queue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFB04A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notification_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="14dp"
        android:indeterminate="false"
        android:indeterminateTint="#FFFF7A00"
        android:max="100"
        android:progressBackgroundTint="#44FFFFFF"
        android:progressTint="#FFFF7A00" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/notification_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notification_previous"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/notification_previous"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/notification_seek_back"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/notification_seek_back"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_rew"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/notification_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/notification_play_background"
            android:contentDescription="@string/notification_play"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/notification_seek_forward"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/notification_seek_forward"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_ff"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/notification_next"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/notification_next"
            android:padding="9dp"
            android:src="@android:drawable/ic_media_next"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/notification_stop"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/notification_stop"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFF785A" />
    </LinearLayout>
</LinearLayout>
