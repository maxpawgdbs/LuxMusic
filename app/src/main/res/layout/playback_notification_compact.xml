<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    tools:ignore="UseAppTint">

    <ImageView
        android:id="@+id/notification_artwork"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notification_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFB04A"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notification_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:indeterminateTint="#FFFF7A00"
            android:max="100"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="#FFFF7A00" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/notification_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/notification_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/notification_previous"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/notification_previous"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/notification_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/notification_play_background"
        android:contentDescription="@string/notification_play"
        android:padding="10dp"
        android:src="@android:drawable/ic_media_play"
        android:tint="@android:color/white" />

    <ImageButton
        android:id="@+id/notification_next"
        android:layout_width="36dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/notification_next"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_next"
        android:tint="@android:color/white" />
</LinearLayout>
